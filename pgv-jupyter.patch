diff --git a/src/main.ts b/src/main.ts
new file mode 100644
index 0000000..f94cecc
--- /dev/null
+++ b/src/main.ts
@@ -0,0 +1,14 @@
+import { GraphView, createGraphSnapshot } from "./index";
+import "./style.css"; // Only keep the core CSS
+
+(window as any).renderPgvNotebook = function(containerId: string, graphJson: any) {
+    const container = document.getElementById(containerId);
+    if (!container) return;
+    const snapshot = createGraphSnapshot(graphJson);
+    const view = new GraphView(container, graphJson.schema || {}, {
+        layoutOptions: { nodeWidth: 240, nodeHeight: 94, layerSpacing: 152, nodeSpacing: 290, margin: 36 },
+        usePanZoom: true,
+        useThemeToggle: true
+    });
+    view.setGraph(snapshot);
+};
